# Force LF on files that run inside the Linux container. Without this, cloning on
# Windows (core.autocrlf=true) rewrites them to CRLF and the container fails to
# start with "exec ... no such file or directory" or "set: Illegal option".
docker-entrypoint.sh text eol=lf
*.sh            text eol=lf
Dockerfile      text eol=lf
docker-compose.yml text eol=lf
.env.example    text eol=lf
