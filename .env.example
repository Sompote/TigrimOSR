# TigrimOS — Docker environment.
# Copy this file to ".env" and fill in a strong token:   cp .env.example .env

# REQUIRED. The access token you type into the web UI to log in.
# Generate a strong one:   openssl rand -hex 32
ACCESS_TOKEN=change-me-to-a-long-random-secret

# Optional: change the HTTP port (must match the port mapping in docker-compose.yml).
# PORT=3001

# Optional: bake the Playwright browser into the image for Browser Control
# (lets the agent drive a real browser). Off by default — adds ~400 MB.
# Set to true, then rebuild:  docker compose up -d --build
# INSTALL_BROWSER=true

# NOTE: LLM provider API keys and the model are NOT set here.
# Set them in the web UI under Settings after first launch; they are saved to
# data/settings.json and persist across restarts via the ./data volume.
